---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ContactForm from '@/components/ContactForm.astro';
import { site } from '@/config/site';
---
<Layout title="Contact" description="Reach Renewing Hope Strategies in Hemet, Murrieta, and Riverside, CA. Call (951) 465-3665 or email office@renewing-hope.org.">
  <section class="bg-mesh-plum bg-[length:200%_200%] animate-gradient-pan py-14 md:py-18">
    <div class="container-wide">
      <SectionHeading
        eyebrow="Let's connect"
        title="Send us a message and we'll get back to you shortly."
        subtitle="This form is not for emergencies. If you are in crisis or thinking about suicide, call or text 988 — free and confidential, 24/7."
      />
    </div>
  </section>

  <section class="section">
    <div class="container-wide grid md:grid-cols-3 gap-10">
      <aside class="space-y-6 reveal-stagger">
        <div class="card reveal">
          <h3 class="font-display text-lg text-plum-900">Phone</h3>
          <p class="mt-2"><a href={`tel:${site.phoneHref}`} class="font-semibold text-plum-600 text-lg">{site.phoneDisplay}</a></p>
        </div>
        <div class="card reveal" style="transition-delay:60ms">
          <h3 class="font-display text-lg text-plum-900">Email</h3>
          <p class="mt-2"><a href={`mailto:${site.email}`} class="font-semibold text-plum-600">{site.email}</a></p>
        </div>
        <div class="card reveal" style="transition-delay:120ms">
          <h3 class="font-display text-lg text-plum-900">Hours</h3>
          <p class="mt-2 text-sm text-plum-700/90">{site.hours.weekday}<br/>{site.hours.friday}</p>
        </div>
        <div class="card bg-plum-900 text-mist-100 border-plum-700 reveal" style="transition-delay:180ms">
          <p class="eyebrow !text-gold-400">Crisis</p>
          <p class="mt-2 text-sm text-mist-200">Call or text <a href="tel:988" class="font-semibold underline">988</a> any time.</p>
        </div>
      </aside>
      <div class="md:col-span-2 reveal" style="transition-delay:80ms">
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>