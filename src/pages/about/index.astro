---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Stats from '@/components/Stats.astro';
import { site } from '@/config/site';
---
<Layout title="About Us" description="Renewing Hope Strategies is a 501(c)(3) nonprofit providing judgement-free mental-health and wellness counseling on a sliding scale across the Inland Empire.">
  <section class="bg-mesh-plum bg-[length:200%_200%] animate-gradient-pan py-14 md:py-20">
    <div class="container-wide grid md:grid-cols-2 gap-10 items-center">
      <div class="reveal">
        <p class="eyebrow !text-sage-700 mb-3">About us</p>
        <h1 class="font-display text-4xl md:text-5xl text-plum-900">Hope, made practical.</h1>
        <p class="mt-4 text-lg text-plum-700/90 max-w-prose">Renewing Hope Strategies (Renewing Hope Family Counseling Center, Inc.) is a 501(c)(3) nonprofit mental-health and wellness organization serving the Inland Empire of California. We exist to remove the barriers — money, stigma, transportation — that keep people from getting help.</p>
      </div>
      <div class="card reveal" style="transition-delay:120ms">
        <p class="eyebrow">Mission</p>
        <p class="mt-2 text-plum-700/90">To provide mental-health and wellness services in a positive, respectful, judgement-free environment, empowering individuals to achieve recovery regardless of socio-economic status.</p>
        <p class="eyebrow mt-6">Vision</p>
        <p class="mt-2 text-plum-700/90">We envision a world where education and awareness about mental health take precedence over the stigma attached to it.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <SectionHeading eyebrow="By the numbers" title="What access looks like in practice." />
      <Stats />
      <div class="mt-10 grid md:grid-cols-3 gap-6 reveal-stagger">
        <div class="card reveal">
          <h3 class="font-display text-lg text-plum-900">Sliding scale</h3>
          <p class="mt-2 text-sm text-plum-700/90">Your fee is based on your household income and family size. No one is turned away for inability to pay.</p>
          <a href="/sliding-scale" class="mt-3 inline-block text-sm font-semibold text-plum-600">See how it works →</a>
        </div>
        <div class="card reveal" style="transition-delay:80ms">
          <h3 class="font-display text-lg text-plum-900">Mobile unit</h3>
          <p class="mt-2 text-sm text-plum-700/90">Our traveling mental-health unit sets up at libraries and community sites across the region.</p>
          <a href="/events" class="mt-3 inline-block text-sm font-semibold text-plum-600">Find a stop →</a>
        </div>
        <div class="card reveal" style="transition-delay:160ms">
          <h3 class="font-display text-lg text-plum-900">Our team</h3>
          <p class="mt-2 text-sm text-plum-700/90">Led by a volunteer board and licensed clinicians committed to accessible care.</p>
          <a href="/about/board" class="mt-3 inline-block text-sm font-semibold text-plum-600">Meet the board →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-mist-100">
    <div class="container-wide">
      <SectionHeading eyebrow="Affiliates" title="Part of a larger network of hope." subtitle="We work alongside closely aligned organizations that share our mission." />
      <div class="mt-8 grid gap-6 md:grid-cols-2 reveal-stagger">
        <a href={site.affiliates.rhfcc} class="card hover:shadow-lift transition reveal">
          <h3 class="font-display text-lg text-plum-900">RHFCC Inc.</h3>
          <p class="mt-2 text-sm text-plum-700/90">Renewing Hope Family Counseling Center, Inc. — our founding corporate entity.</p>
        </a>
        <a href={site.affiliates.moveWithHope} class="card hover:shadow-lift transition reveal" style="transition-delay:80ms">
          <h3 class="font-display text-lg text-plum-900">Move With Hope</h3>
          <p class="mt-2 text-sm text-plum-700/90">A movement-based wellness companion organization pairing physical activity with mental health.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>