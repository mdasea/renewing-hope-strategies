---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Stats from '@/components/Stats.astro';
import WingDivider from '@/components/WingDivider.astro';
import { site } from '@/config/site';

const aboutImg = '/brand/group-meeting.jpg';
const scaleImg = '/brand/board-banner.jpg';
const mobileUnitImg = '/brand/park-people.jpg';
const teamImg = '/brand/hero-group.jpg';
const affiliatesImg = 'https://images.unsplash.com/photo-1559027615-cd4628902d4a?auto=format&fit=crop&w=800&q=80';
---
<Layout title="About Us" description="Renewing Hope Strategies is a 501(c)(3) nonprofit providing judgement-free mental-health and wellness counseling on a sliding scale across the Inland Empire.">
  <section class="relative overflow-hidden bg-plum-900 text-mist-50">
    <img src={aboutImg} alt="" aria-hidden="true" loading="eager" class="absolute inset-0 h-full w-full object-cover opacity-25 animate-fade-in" />
    <div class="absolute inset-0 bg-gradient-to-br from-plum-950/80 to-plum-800/40"></div>
    <div class="container-wide relative py-14 md:py-20 grid md:grid-cols-2 gap-10 items-center">
      <div class="reveal">
        <p class="eyebrow !text-sage-300 mb-3">About us</p>
        <h1 class="font-display text-4xl md:text-5xl text-white">Hope, made practical.</h1>
        <p class="mt-4 text-lg text-mist-100/90 max-w-prose">Renewing Hope Strategies (Renewing Hope Family Counseling Center, Inc.) is a 501(c)(3) nonprofit mental-health and wellness organization serving the Inland Empire of California. We exist to remove the barriers — money, stigma, transportation — that keep people from getting help.</p>
      </div>
      <div class="card bg-white/10 backdrop-blur border-white/20 text-mist-100 reveal" style="transition-delay:120ms">
        <p class="eyebrow !text-gold-400">Mission</p>
        <p class="mt-2 text-mist-200">To provide mental-health and wellness services in a positive, respectful, judgement-free environment, empowering individuals to achieve recovery regardless of socio-economic status.</p>
        <p class="eyebrow !text-gold-400 mt-6">Vision</p>
        <p class="mt-2 text-mist-200">We envision a world where education and awareness about mental health take precedence over the stigma attached to it.</p>
      </div>
    </div>
  </section>

  <WingDivider variant="sage" />

  <section class="section">
    <div class="container-wide">
      <SectionHeading eyebrow="By the numbers" title="What access looks like in practice." />
      <Stats />
      <div class="mt-10 grid md:grid-cols-3 gap-6 reveal-stagger">
        <div class="card card-tilt overflow-hidden !p-0 reveal">
          <img src={scaleImg} alt="" aria-hidden="true" class="h-32 w-full object-cover" loading="lazy" />
          <div class="p-5">
            <h3 class="font-display text-lg text-plum-900">Sliding scale</h3>
            <p class="mt-2 text-sm text-plum-700/90">Your fee is based on your household income and family size. No one is turned away for inability to pay.</p>
            <a href="/sliding-scale" class="mt-3 inline-block text-sm font-semibold text-plum-600">See how it works →</a>
          </div>
        </div>
        <div class="card card-tilt overflow-hidden !p-0 reveal" style="transition-delay:80ms">
          <img src={mobileUnitImg} alt="" aria-hidden="true" class="h-32 w-full object-cover" loading="lazy" />
          <div class="p-5">
            <h3 class="font-display text-lg text-plum-900">Mobile unit</h3>
            <p class="mt-2 text-sm text-plum-700/90">Our traveling mental-health unit sets up at libraries and community sites across the region.</p>
            <a href="/events" class="mt-3 inline-block text-sm font-semibold text-plum-600">Find a stop →</a>
          </div>
        </div>
        <div class="card card-tilt overflow-hidden !p-0 reveal" style="transition-delay:160ms">
          <img src={teamImg} alt="" aria-hidden="true" class="h-32 w-full object-cover" loading="lazy" />
          <div class="p-5">
            <h3 class="font-display text-lg text-plum-900">Our team</h3>
            <p class="mt-2 text-sm text-plum-700/90">Led by a volunteer board and licensed clinicians committed to accessible care.</p>
            <a href="/about/board" class="mt-3 inline-block text-sm font-semibold text-plum-600">Meet the board →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-mist-100">
    <div class="container-wide grid md:grid-cols-2 gap-10 items-center">
      <div class="reveal">
        <SectionHeading eyebrow="Affiliates" title="Part of a larger network of hope." subtitle="We work alongside closely aligned organizations that share our mission." />
        <div class="mt-6 grid gap-4 reveal-stagger">
          <a href={site.affiliates.rhfcc} class="card card-tilt hover:shadow-lift transition reveal">
            <h3 class="font-display text-lg text-plum-900">RHFCC Inc.</h3>
            <p class="mt-2 text-sm text-plum-700/90">Renewing Hope Family Counseling Center, Inc. — our founding corporate entity.</p>
          </a>
          <a href={site.affiliates.moveWithHope} class="card card-tilt hover:shadow-lift transition reveal" style="transition-delay:80ms">
            <h3 class="font-display text-lg text-plum-900">Move With Hope</h3>
            <p class="mt-2 text-sm text-plum-700/90">A movement-based wellness companion organization pairing physical activity with mental health.</p>
          </a>
        </div>
      </div>
      <div class="reveal" style="transition-delay:120ms">
        <img src={affiliatesImg} alt="" aria-hidden="true" class="rounded-2xl shadow-lift w-full aspect-[4/3] object-cover" loading="lazy" />
      </div>
    </div>
  </section>
</Layout>
