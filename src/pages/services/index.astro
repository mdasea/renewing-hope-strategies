---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServicesGrid from '@/components/ServicesGrid.astro';
import { services } from '@/data/services';
import { areas } from '@/config/site';
import ServiceIcon from '@/components/ServiceIcon.astro';
---
<Layout
  title="Counseling Services"
  description="Anxiety, depression, relationship, anger management, and eating-disorder counseling in Hemet, Murrieta, and Riverside, CA. Sliding-scale. Judgement-free. Nonprofit."
>
  <section class="bg-mesh-plum bg-[length:200%_200%] animate-gradient-pan py-16 md:py-20">
    <div class="container-wide">
      <SectionHeading
        align="center"
        eyebrow="Our services"
        title="Counseling built around your life, not the other way around."
        subtitle="All five specialties are offered on a sliding scale, in-office, by telehealth, and via our mobile unit across Hemet, Murrieta, and Riverside."
      />
    </div>
  </section>

  <ServicesGrid />

  <section class="section">
    <div class="container-wide">
      <SectionHeading eyebrow="Find your fit" title="Choose a service to learn more." />
      <div class="grid gap-4 md:grid-cols-2 mt-8 reveal-stagger">
        {services.map((s, i) => (
          <a href={`/services/${s.slug}`} class="card flex gap-4 items-start hover:shadow-lift transition reveal" style={`transition-delay:${i*70}ms`}>
            <div class="h-12 w-12 rounded-xl bg-plum-50 text-plum-600 flex items-center justify-center shrink-0"><ServiceIcon name={s.icon} /></div>
            <div>
              <h3 class="font-display text-xl text-plum-900">{s.name}</h3>
              <p class="text-sm mt-1 text-plum-700/90">{s.tagline}</p>
              <p class="mt-3 text-xs flex flex-wrap gap-1.5 text-plum-600">
                {Object.values(areas).map(a => <span class="rounded-full bg-mist-100 px-2 py-0.5">{a.name.split(',')[0]}</span>)}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>