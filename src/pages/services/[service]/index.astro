---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ContactForm from '@/components/ContactForm.astro';
import Accordion from '@/components/Accordion.astro';
import WingDivider from '@/components/WingDivider.astro';
import { services } from '@/data/services';
import { areas, site } from '@/config/site';
import ServiceIcon from '@/components/ServiceIcon.astro';

export function getStaticPaths() {
  return services.map(s => ({ params: { service: s.slug }, props: { service: s } }));
}
const { service } = Astro.props;
const medicalSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: `${service.name} — ${site.name}`,
  url: `${site.url}/services/${service.slug}`,
  telephone: site.phoneDisplay,
  areaServed: Object.values(areas).map(a => a.name).join(', '),
  priceRange: 'Sliding scale'
};
const heroImage: Record<string, string> = {
  anxiety: 'https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=1400&q=80',
  depression: 'https://images.unsplash.com/photo-1544027993-37dbfe43562a?auto=format&fit=crop&w=1400&q=80',
  relationship: 'https://images.unsplash.com/photo-1518621736915-f3b1c41bfd00?auto=format&fit=crop&w=1400&q=80',
  'anger-management': 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=1400&q=80',
  'eating-disorders': 'https://images.unsplash.com/photo-1498837167922-ddd27525d352?auto=format&fit=crop&w=1400&q=80'
};
const bodyImage: Record<string, string> = {
  anxiety: 'https://images.unsplash.com/photo-1532938911079-1b06ac7ceec7?auto=format&fit=crop&w=800&q=80',
  depression: 'https://images.unsplash.com/photo-1509099836639-18ba1795216d?auto=format&fit=crop&w=800&q=80',
  relationship: 'https://images.unsplash.com/photo-1516307365426-bea591f05011?auto=format&fit=crop&w=800&q=80',
  'anger-management': 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=800&q=80',
  'eating-disorders': 'https://images.unsplash.com/photo-1498837167922-ddd27525d352?auto=format&fit=crop&w=800&q=80'
};
const img = heroImage[service.slug];
const sideImg = bodyImage[service.slug];
---
<Layout
  title={service.name}
  description={service.tagline + ' ' + service.overview[0].slice(0,140)}
  schema={medicalSchema}
>
  <section class="relative overflow-hidden bg-plum-900 text-mist-50">
    <img src={img} alt="" aria-hidden="true" loading="eager" class="absolute inset-0 h-full w-full object-cover opacity-30 animate-fade-in" />
    <div class="absolute inset-0 bg-gradient-to-br from-plum-950/80 to-plum-800/40"></div>
    <div class="container-wide relative py-16 md:py-24 grid md:grid-cols-3 gap-8 items-center">
      <div class="md:col-span-2 reveal">
        <p class="eyebrow !text-sage-300 mb-3">Counseling</p>
        <h1 class="font-display text-4xl md:text-5xl text-white leading-tight">{service.name}</h1>
        <p class="mt-4 text-xl text-mist-100/90">{service.tagline}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/contact" class="btn-gold">Request an appointment</a>
          <a href="/sliding-scale" class="btn-secondary text-sm !bg-white/10 !text-white !border-white/30 hover:!bg-white/20">Sliding-scale info</a>
        </div>
      </div>
      <div class="hidden md:flex justify-center reveal" style="transition-delay:120ms">
        <div class="h-24 w-24 rounded-3xl bg-sage-400 text-plum-950 flex items-center justify-center shadow-lift animate-float">
          <ServiceIcon name={service.icon} class="h-12 w-12" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide grid md:grid-cols-3 gap-10">
      <article class="md:col-span-2 space-y-8">
        <div class="reveal">
          <h2 class="font-display text-2xl text-plum-900">What {service.short.toLowerCase()} looks like</h2>
          <div class="mt-4 space-y-4 text-plum-700/90">
            {service.overview.map(p => <p>{p}</p>)}
          </div>
        </div>

        <div class="reveal">
          <img src={sideImg} alt="" aria-hidden="true" class="rounded-2xl shadow-lift w-full h-48 md:h-64 object-cover" loading="lazy" />
        </div>

        <div class="card reveal">
          <h3 class="font-display text-xl text-plum-900">Signs you might want to talk to someone</h3>
          <ul class="mt-4 space-y-2">
            {service.signs.map(s => (
              <li class="flex gap-3 text-plum-700/90"><span aria-hidden="true" class="text-plum-400">●</span>{s}</li>
            ))}
          </ul>
        </div>

        <div class="reveal">
          <h3 class="font-display text-xl text-plum-900">How we help</h3>
          <ul class="mt-4 space-y-2">
            {service.howWeHelp.map(h => (
              <li class="flex gap-3 text-plum-700/90"><span aria-hidden="true" class="text-sage-600">✓</span>{h}</li>
            ))}
          </ul>
        </div>

        <div class="reveal">
          <h3 class="font-display text-xl text-plum-900">What to expect</h3>
          <ul class="mt-4 space-y-2">
            {service.whatToExpect.map(w => (
              <li class="flex gap-3 text-plum-700/90"><span aria-hidden="true" class="text-sage-600">→</span>{w}</li>
            ))}
          </ul>
        </div>
      </article>

      <aside class="space-y-6">
        <div class="card bg-plum-900 text-mist-100 border-plum-700 reveal">
          <p class="eyebrow !text-gold-400">Crisis note</p>
          <p class="mt-2 text-sm">If you are in danger or having thoughts of suicide, call or text <a href="tel:988" class="font-semibold underline">988</a> any time, day or night.</p>
        </div>
        <div class="card reveal" style="transition-delay:80ms">
          <h3 class="font-display text-lg text-plum-900">Find {service.short.toLowerCase()} near you</h3>
          <div class="mt-3 grid gap-2">
            {Object.values(areas).map(a => (
              <a href={`/services/${service.slug}/${a.slug}`} class="block rounded-xl bg-mist-100 px-3 py-2 text-sm text-plum-700 hover:bg-mist-200 transition-colors">{service.name} in {a.name.split(',')[0]}</a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <WingDivider variant="plum" />

  <section class="section bg-mist-100">
    <div class="container-prose">
      <SectionHeading align="center" eyebrow="Common questions" title={`${service.short} FAQ`} />
      <div class="mt-8">
        <Accordion items={service.faqs} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide grid md:grid-cols-2 gap-10">
      <div class="reveal">
        <SectionHeading title="Take the first step." subtitle="Request an appointment and someone from our team will call you back within one business day." />
        <p class="mt-4 text-sm text-plum-700/80">Or call us at <a href={`tel:${site.phoneHref}`} class="font-semibold">{site.phoneDisplay}</a>. Sliding-scale fees apply.</p>
      </div>
      <div class="reveal" style="transition-delay:80ms"><ContactForm compact /></div>
    </div>
  </section>
</Layout>
