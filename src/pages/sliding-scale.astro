---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { site } from '@/config/site';
---
<Layout title="Sliding Scale" description="Renewing Hope Strategies offers income-based sliding-scale fees so cost is never a barrier to counseling. Download the application in English or Spanish.">
  <section class="bg-mesh-plum bg-[length:200%_200%] animate-gradient-pan py-14 md:py-18">
    <div class="container-wide">
      <p class="eyebrow !text-sage-700 mb-3">Sliding Scale</p>
      <h1 class="font-display text-4xl md:text-5xl text-plum-900">Cost should never be the reason you don't reach out.</h1>
      <p class="mt-4 text-lg text-plum-700/90 max-w-prose">Renewing Hope Family Counseling Center, Inc. operates a Sliding Fee Discount Program. Your fee is based on your household income and family size — not on what you can prove you can pay. No one is turned away for inability to pay.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-wide grid md:grid-cols-2 gap-10">
      <div class="space-y-6 reveal">
        <div>
          <h2 class="font-display text-2xl text-plum-900">How the sliding scale works</h2>
          <ol class="mt-4 space-y-3">
            <li class="flex gap-3"><span class="font-display text-plum-600 text-xl">1</span><span class="text-plum-700/90">Download and complete the application (English or Spanish).</span></li>
            <li class="flex gap-3"><span class="font-display text-plum-600 text-xl">2</span><span class="text-plum-700/90">Provide proof of household income (recent pay stub, tax return, or benefits letter) and family size.</span></li>
            <li class="flex gap-3"><span class="font-display text-plum-600 text-xl">3</span><span class="text-plum-700/90">Our team confirms your sliding-scale level within a few business days.</span></li>
            <li class="flex gap-3"><span class="font-display text-plum-600 text-xl">4</span><span class="text-plum-700/90">Your discounted fee applies to every session from that point on — no surprises.</span></li>
          </ol>
        </div>
        <div class="card bg-plum-900 text-mist-100 border-plum-700">
          <h3 class="font-display text-lg text-white">If you cannot pay anything right now</h3>
          <p class="mt-2 text-mist-200 text-sm">Apply anyway. We hold a charity-care fund for community members in acute financial hardship. Use the contact form or call us at <a href={`tel:${site.phoneHref}`} class="font-semibold underline">{site.phoneDisplay}</a> — we will work with you.</p>
        </div>
      </div>

      <aside class="space-y-6 reveal" style="transition-delay:120ms">
        <SectionHeading eyebrow="Download" title="Sliding-scale application" />
        <div class="grid gap-4">
          <a href={site.slidingScale.english} class="card hover:shadow-lift transition flex items-center gap-4">
            <span class="font-display text-2xl text-plum-600">EN</span>
            <div>
              <p class="font-semibold text-plum-900">Application (English)</p>
              <p class="text-xs text-plum-700/70">PDF · Download &amp; print</p>
            </div>
          </a>
          <a href={site.slidingScale.spanish} class="card hover:shadow-lift transition flex items-center gap-4">
            <span class="font-display text-2xl text-plum-600">ES</span>
            <div>
              <p class="font-semibold text-plum-900">Aplicación (Español)</p>
              <p class="text-xs text-plum-700/70">PDF · Descargar &amp; imprimir</p>
            </div>
          </a>
        </div>
        <p class="text-xs text-plum-700/70">Having trouble opening the PDF? Contact <a href={`mailto:${site.email}`} class="underline">{site.email}</a> and we will email or mail you a copy.</p>
      </aside>
    </div>
  </section>
</Layout>