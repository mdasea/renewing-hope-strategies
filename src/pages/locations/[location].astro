---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { areas, site } from '@/config/site';
import { services } from '@/data/services';

export function getStaticPaths() {
  return (Object.keys(areas) as Array<keyof typeof areas>).map(slug => ({
    params: { location: slug },
    props: { area: areas[slug as keyof typeof areas] }
  }));
}
const { area } = Astro.props;
const cityName = area.name.split(',')[0];
// Unsplash city/Inland Empire imagery.
const cityImg: Record<string, string> = {
  hemet: 'https://images.unsplash.com/photo-1517486808906-6ca8b3f04846?auto=format&fit=crop&w=1400&q=80',
  murrieta: 'https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1400&q=80',
  riverside: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=1400&q=80'
};
const cityBodyImg: Record<string, string> = {
  hemet: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=800&q=80',
  murrieta: 'https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80',
  riverside: 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=800&q=80'
};
const img = cityImg[area.slug] || cityImg.hemet;
const bodyImg = cityBodyImg[area.slug] || cityBodyImg.hemet;
---
<Layout
  title={`Counseling in ${area.name}`}
  description={`Mental-health counseling in ${cityName}, CA. Anxiety, depression, relationship, anger management, eating disorders. Sliding scale. Nonprofit. Mobile unit.`}
>
  <section class="relative overflow-hidden bg-plum-900 text-mist-50">
    <img src={img} alt="" aria-hidden="true" loading="eager" class="absolute inset-0 h-full w-full object-cover opacity-30 animate-fade-in" />
    <div class="absolute inset-0 bg-gradient-to-br from-plum-950/80 to-plum-800/40"></div>
    <div class="container-wide relative py-14 md:py-20">
      <p class="eyebrow !text-sage-300 mb-3 reveal">Where we serve</p>
      <h1 class="font-display text-4xl md:text-5xl text-white reveal" style="transition-delay:80ms">{area.name}</h1>
      <p class="mt-4 text-lg text-mist-100/90 max-w-prose reveal" style="transition-delay:140ms">{area.blurb}</p>
      <div class="mt-6 reveal" style="transition-delay:200ms">
        <a href="/contact" class="btn-gold">Request an appointment</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <SectionHeading eyebrow="Specialties in town" title={`${cityName} counseling services`} />
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 mt-8 reveal-stagger">
        {services.map((s, i) => (
          <a href={`/services/${s.slug}/${area.slug}`} class="card card-tilt hover:shadow-lift transition reveal" style={`transition-delay:${i*70}ms`}>
            <h3 class="font-display text-lg text-plum-900">{s.name} in {cityName}</h3>
            <p class="mt-2 text-sm text-plum-700/90">{s.tagline}</p>
          </a>
        ))}
      </div>

      <div class="mt-10 reveal">
        <img src={bodyImg} alt="" aria-hidden="true" class="rounded-2xl shadow-lift w-full h-48 md:h-64 object-cover" loading="lazy" />
      </div>

      <div class="mt-12 card bg-plum-900 text-mist-100 border-plum-700 reveal">
        <h3 class="font-display text-xl text-white">Mobile unit visits {cityName}</h3>
        <p class="mt-2 text-sm text-mist-200">Watch our calendar — the mobile unit sets up at community sites across town for free intake, sliding-scale enrollment, and resources. <a href="/events" class="font-semibold text-gold-400">See dates →</a></p>
      </div>
    </div>
  </section>
</Layout>