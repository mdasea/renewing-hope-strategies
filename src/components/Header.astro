---
import { site } from '@/config/site';
import { services } from '@/data/services';
import { areas } from '@/config/site';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services', children: services.map(s => ({ label: s.name, href: `/services/${s.slug}` })) },
  { label: 'Locations', href: '/locations', children: Object.values(areas).map(a => ({ label: a.name, href: `/locations/${a.slug}` })) },
  { label: 'About', href: '/about', children: [
      { label: 'Meet the Board', href: '/about/board' },
      { label: 'Sliding Scale', href: '/sliding-scale' }
  ] },
  { label: 'Get Involved', href: '/get-involved', children: [
      { label: 'Donate', href: '/donate' },
      { label: 'Events', href: '/events' },
      { label: 'Volunteer', href: '/get-involved#volunteer' }
  ] }
];
const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---
<header class="bg-mist-50/90 backdrop-blur sticky top-0 z-40 border-b border-mist-200">
  <div class="container-wide flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-3 group" aria-label="Renewing Hope Strategies home" data-logo-entrance>
      <img
        src="/brand/logo.png"
        alt=""
        aria-hidden="true"
        width="44" height="44"
        class="h-11 w-11 rounded-full object-cover ring-2 ring-plum-200 group-hover:ring-sage-400 transition shadow-soft"
      />
      <span class="leading-tight">
        <span class="block font-display text-lg text-plum-800 group-hover:text-plum-900 transition">{site.shortName}</span>
        <span class="block text-[10px] uppercase tracking-wider text-sage-700">{site.legal}</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden lg:flex items-center gap-1">
      {navItems.map(item => (
        <div class="relative group">
          <a
            href={item.href}
            class:list={[
              'px-3.5 py-2 rounded-full text-sm font-semibold transition',
              isActive(item.href) ? 'bg-plum-700 text-white' : 'text-plum-800 hover:bg-mist-100'
            ]}
          >
            {item.label}
            {item.children && <span aria-hidden="true" class="ml-1 text-[10px] inline-block transition-transform duration-200 group-hover:rotate-180">▼</span>}
          </a>
          {item.children && (
            <div class="invisible opacity-0 scale-95 group-hover:visible group-hover:opacity-100 group-hover:scale-100 transition-all duration-200 origin-top-left absolute top-full left-0 mt-1 w-64 bg-white border border-mist-200 shadow-lift rounded-2xl p-2 grid gap-1">
              {item.children.map(c => (
                <a href={c.href} class="block rounded-xl px-3 py-2 text-sm text-plum-800 hover:bg-mist-100 transition-colors">{c.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={`tel:${site.phoneHref}`} class="hidden md:inline-flex btn-secondary !py-2 !px-4 text-sm">
        <span class="sr-only">Call</span>{site.phoneDisplay}
      </a>
      <a href="/donate" class="btn-gold !py-2.5 !px-5 text-sm">Donate</a>
      <button id="menuBtn" class="lg:hidden btn-secondary !px-3 !py-2" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
        <span class="hamburger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <nav id="mobileNav" aria-label="Mobile" class="lg:hidden bg-white border-t border-mist-200 container-wide grid gap-2 overflow-hidden transition-all duration-300 ease-out max-h-0 opacity-0">
    <div class="py-3 grid gap-2">
      {navItems.map(item => (
        <div class="border-b border-mist-100 pb-2">
          <a href={item.href} class="block font-display text-lg text-plum-800 py-1">{item.label}</a>
          {item.children && (
            <div class="pl-3 mt-1 grid gap-1">
              {item.children.map(c => (
                <a href={c.href} class="block text-sm text-plum-700 py-1">{c.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a href={`tel:${site.phoneHref}`} class="btn-secondary text-sm mt-2">Call {site.phoneDisplay}</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menuBtn');
  const nav = document.getElementById('mobileNav');
  btn?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false;
    btn.setAttribute('aria-expanded', String(isOpen));
    if (isOpen) {
      nav.classList.add('max-h-[800px]', 'opacity-100');
      nav.classList.remove('max-h-0', 'opacity-0');
      btn.setAttribute('aria-label', 'Close menu');
    } else {
      nav.classList.add('max-h-0', 'opacity-0');
      nav.classList.remove('max-h-[800px]', 'opacity-100');
      btn.setAttribute('aria-label', 'Open menu');
    }
  });
</script>
