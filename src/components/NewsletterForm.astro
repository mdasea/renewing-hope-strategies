---
import { site } from '@/config/site';
---
<form action={`https://formspree.io/f/${site.forms.newsletter}`} method="POST" data-ajax class="grid gap-3 sm:grid-cols-2 md:grid-cols-3">
  <div class="field-float">
    <input id="nl-first" name="first_name" type="text" class="field-input" required placeholder=" " />
    <label for="nl-first" class="field-float-label">First name *</label>
  </div>
  <div class="field-float">
    <input id="nl-email" name="email" type="email" class="field-input" required placeholder=" " />
    <label for="nl-email" class="field-float-label">Email *</label>
  </div>
  <div class="flex items-end">
    <label class="flex items-start gap-2 text-sm text-plum-700/90 -mt-2 mb-2">
      <input type="checkbox" name="sms" class="mt-1" />
      <span>Also text me the mobile unit's weekly location.</span>
    </label>
  </div>
  <div class="sm:col-span-2 md:col-span-3">
    <button type="submit" class="btn-primary relative">
      <span class="btn-label">Subscribe for updates</span>
      <span class="btn-dots hidden">
        <span></span><span></span><span></span>
      </span>
    </button>
    <p class="text-xs text-plum-700/70 mt-2">No spam. Unsubscribe anytime. Your info stays with RHS only.</p>
  </div>
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
</form>
