---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  dark?: boolean;
}
const { eyebrow, title, subtitle, align = 'left', dark = false } = Astro.props;
---
<div class:list={["max-w-3xl reveal", align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class:list={["eyebrow mb-3", dark && '!text-sage-300']}>{eyebrow}</p>}
  <h2 class:list={["font-display text-3xl md:text-4xl leading-tight", dark ? 'text-white' : 'text-plum-900']}>{title}</h2>
  {subtitle && <p class:list={["mt-4 text-lg", dark ? 'text-mist-100/90' : 'text-plum-700/90']}>{subtitle}</p>}
</div>