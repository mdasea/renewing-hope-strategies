---
import { site } from '@/config/site';
export interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<form
  class:list={["grid gap-4", compact ? "sm:grid-cols-2" : "md:grid-cols-2"]}
  action={`https://formspree.io/f/${site.forms.contact}`}
  method="POST"
  aria-label="Contact Renewing Hope Strategies"
>
  <div>
    <label for="cf-first" class="field-label">First name *</label>
    <input id="cf-first" name="first_name" class="field-input" type="text" required autocomplete="given-name" />
  </div>
  <div>
    <label for="cf-last" class="field-label">Last name *</label>
    <input id="cf-last" name="last_name" class="field-input" type="text" required autocomplete="family-name" />
  </div>
  <div class={compact ? "sm:col-span-2" : "md:col-span-2"}>
    <label for="cf-email" class="field-label">Email *</label>
    <input id="cf-email" name="email" class="field-input" type="email" required autocomplete="email" />
  </div>
  <div class={compact ? "sm:col-span-2" : "md:col-span-2"}>
    <label for="cf-phone" class="field-label">Phone (optional)</label>
    <input id="cf-phone" name="phone" class="field-input" type="tel" autocomplete="tel" />
  </div>
  <div class={compact ? "sm:col-span-2" : "md:col-span-2"}>
    <label for="cf-subject" class="field-label">Subject</label>
    <input id="cf-subject" name="subject" class="field-input" type="text" />
  </div>
  <div class={compact ? "sm:col-span-2" : "md:col-span-2"}>
    <label for="cf-msg" class="field-label">Your message *</label>
    <textarea id="cf-msg" name="message" rows="4" class="field-input" required></textarea>
  </div>
  <div class={compact ? "sm:col-span-2" : "md:col-span-2"}>
    <label class="flex items-start gap-3 text-sm text-plum-700/90">
      <input type="checkbox" name="consent" required class="mt-1" />
      <span>I consent to be contacted by Renewing Hope Strategies about my request. This is not a crisis line — if you are in danger or in crisis, call or text <a href="tel:988" class="underline font-semibold">988</a>.</span>
    </label>
  </div>
  <!-- Honeypot -->
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <div class={compact ? "sm:col-span-2" : "md:col-span-2"}>
    <button type="submit" class="btn-primary w-full md:w-auto">Send message</button>
  </div>
</form>