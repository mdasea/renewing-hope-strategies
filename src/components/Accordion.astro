---
export interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---
<div class="space-y-4">
  {items.map((f, i) => (
    <div class="card">
      <button
        type="button"
        class="accordion-trigger"
        aria-expanded="false"
        aria-controls={`faq-panel-${i}`}
        id={`faq-trigger-${i}`}
      >
        <span class="font-display text-lg text-plum-900">{f.q}</span>
        <svg class="accordion-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </button>
      <div
        class="accordion-panel"
        id={`faq-panel-${i}`}
        role="region"
        aria-labelledby={`faq-trigger-${i}`}
      >
        <div class="accordion-content">
          <p class="mt-3 text-plum-700/90">{f.a}</p>
        </div>
      </div>
    </div>
  ))}
</div>
