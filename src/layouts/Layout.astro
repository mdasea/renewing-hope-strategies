---
import { site } from '@/config/site';
import '@/styles/global.css';
import CrisisBar from '@/components/CrisisBar.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  schema?: object | object[];
  /** Hides the 988 crisis bar (rare; default false) */
  hideCrisisBar?: boolean;
}

const {
  title,
  description = 'Renewing Hope Strategies is a 501(c)(3) nonprofit providing judgement-free mental-health and wellness counseling in Hemet, Murrieta, and Riverside, CA. Sliding-scale fees. No one turned away for inability to pay.',
  ogImage,
  schema,
  hideCrisisBar = false
} = Astro.props;

const fullTitle = title
  ? `${title} | ${site.name}`
  : `${site.name} — ${site.tagline}`;

const canonical = new URL(Astro.url.pathname, site.url).href;
const og = ogImage ? new URL(ogImage, site.url).href : undefined;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: site.name,
  alternateName: 'Renewing Hope Family Counseling Center, Inc.',
  url: site.url,
  telephone: site.phoneDisplay,
  email: site.email,
  description:
    'A 501(c)(3) nonprofit mental-health and wellness organization providing counselling in Hemet, Murrieta, and Riverside, CA with sliding-scale fees and mobile services.',
  sameAs: [site.social.facebook, site.affiliates.rhfcc, site.affiliates.moveWithHope],
  areaServed: 'Hemet, Murrieta, Riverside, CA'
};

const schemaArray = [orgSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href="/brand/logo-square.jpg" />
    <link rel="apple-touch-icon" href="/brand/logo-square.jpg" />
    <link rel="icon" type="image/png" href="/brand/logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- View Transitions for SPA-like navigation (graceful, opt-in by browser support) -->
    <ClientRouter />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={og} />}
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts: preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
    />

    <!-- Crisis info surfaced for assistive tech in case bar is hidden -->
    {!hideCrisisBar && (
      <meta name="x-crisis-resource" content="988 Suicide & Crisis Lifeline — call or text 988" />
    )}

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaArray[0])} />
    {schemaArray.length > 1 && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaArray.slice(1))} />
    )}
  </head>
  <body>
    <a href="#main" class="sr-only-focusable absolute left-2 top-2 z-50 bg-plum-700 text-white px-4 py-2 rounded">Skip to main content</a>
    {!hideCrisisBar && <CrisisBar />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Astro bundles this client-side; re-init on view transitions too.
      import { initReveal, initCountUp } from '@/scripts/motion';
      document.addEventListener('astro:after-swap', () => {
        initReveal();
        initCountUp();
      });
    </script>
  </body>
</html>